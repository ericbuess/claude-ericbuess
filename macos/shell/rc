# Git helpers
gp() {
    if [ -z "$1" ]; then
        echo "Error: Commit message required"
        return 1
    fi
    git add -A
    git commit -m "$1"
    git push
}

ga() {
    if [ -z "$1" ]; then
        echo "Error: Commit message required"
        return 1
    fi
    git pull --rebase
    git commit --amend -m "$1"
    git push --force-with-lease
}

gd() {
    local current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$current_branch" != "main" && "$current_branch" != "dev" ]]; then
        echo "Error: Not on main or dev branch"
        return 1
    fi
    git checkout main && git merge dev && git push && git checkout dev
}

# uv helpers
uve() {
    if [ -z "$1" ]; then
        echo "Error: Environment name required"
        return 1
    fi
    uv venv "$1"
    echo "Virtual environment '$1' created"
    echo "Activate with: source $1/bin/activate"
}

uva() {
    if [ -z "$1" ]; then
        echo "Error: Environment name required"
        return 1
    fi
    if [ ! -d "$1" ]; then
        echo "Error: Environment '$1' not found"
        return 1
    fi
    source "$1/bin/activate"
    echo "Virtual environment '$1' activated"
}

# Activate .venv and run Python script with uv
v() {
    if [[ -f ".venv/bin/activate" ]]; then
        source .venv/bin/activate && python "$@"
    else
        echo "Creating venv with uv..."
        uv venv .venv && source .venv/bin/activate && uv pip install -r
requirements.txt 2>/dev/null || true && python "$@"
    fi
}

