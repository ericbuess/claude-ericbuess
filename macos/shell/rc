# Add Homebrew's bin directory and Python to PATH
if command -v brew &>/dev/null; then
  # Get the latest available Python version from Homebrew dynamically
  brew_latest_python_formula=$(brew list --formula | grep -E "^python(@[0-9]+\.[0-9]+)?$" | sort -Vr | head -1)

  if [ -n "$brew_latest_python_formula" ]; then
    brew_python_path="$(brew --prefix)/opt/$brew_latest_python_formula"
    if [ -d "$brew_python_path" ]; then
      # Add Homebrew Python libexec/bin to PATH (for python command)
      export PATH="$brew_python_path/libexec/bin:$brew_python_path/bin:$PATH"
    fi
  fi

  # Add Homebrew's bin directory to PATH (for uv and other tools)
  export PATH="$(brew --prefix)/bin:$PATH"
fi

