MOSH_BIN="$(command -v mosh || true)"

# Plain mosh into the VM (no tmux)
vm() {
    if [ -n "$MOSH_BIN" ]; then
        mosh --ssh="ssh $MOSH_SSH_OPTS -R 9999:localhost:9999" "$VM_HOST" -- "$@"
    else
        echo "mosh not found; falling back to ssh"
        ssh $MOSH_SSH_OPTS -R 9999:localhost:9999 "$VM_HOST" "$@"
    fi
}

# Mosh into a tmux session on the VM (attach if exists, create if not)
vmt() {
    local session="${1:-main}"
    shift || true
    if [ -n "$MOSH_BIN" ]; then
        mosh --ssh="ssh $MOSH_SSH_OPTS -R 9999:localhost:9999" "$VM_HOST" -- tmux new-session -A -s "$session" "$@"
    else
        echo "mosh not found; falling back to ssh"
        ssh $MOSH_SSH_OPTS -R 9999:localhost:9999 "$VM_HOST" "tmux new-session -A -s '$session' $*"
    fi
}

update() {
    echo "🚀 Starting full system update..."

    echo "🔄 Checking and updating uv..."
    if command -v brew &>/dev/null; then
        if brew list --formula | grep -q "^uv$"; then
            echo "Updating uv to latest version..."
            brew upgrade uv
            echo "✅ uv updated to $(uv --version 2>&1 | head -n 1)"
        else
            echo "uv not found in Homebrew. Installing..."
            brew install uv
            echo "✅ uv installed: $(uv --version 2>&1 | head -n 1)"
        fi
    else
        echo "⚠️ Homebrew not found. Cannot update uv via Homebrew."
    fi

    echo "🔄 Updating Homebrew..."
    brew update && brew upgrade

    echo "🧹 Cleaning up Homebrew..."
    brew cleanup

    echo "🔄 Updating npm..."
    npm install -g npm

    echo "🧹 Clearing npm cache..."
    npm cache clean --force

    echo "🔄 Updating global npm packages..."
    npm update -g

    echo "🧹 Verifying npm cache..."
    npm cache verify

    echo "🔄 Updating pnpm..."
    # The pnpm install script might show warnings, but it's standard.
    # The subsequent 'pnpm update -g' updates global packages.
    curl -fsSL https://get.pnpm.io/install.sh | sh -
    pnpm update -g

    # Conda has been removed from the system

    # UV has replaced pip for package management
    echo "🔄 Checking uv status..."
    if command -v uv &>/dev/null; then
        echo "✅ uv version: $(uv --version 2>&1 | head -n 1)"
        echo "   Use 'uv venv <env_name>' to create virtual environments"
        echo "   Use 'source <env_name>/bin/activate' to activate environments"
    else
        echo "⚠️ uv not installed. Consider installing with: brew install uv"
    fi

    echo "🔄 Updating NVM and Node.js versions..."
    if command -v nvm &> /dev/null; then
        # Capture the current Node.js version
        previous_version=$(nvm version)

        # Install the latest Node.js version and reinstall global packages from the previous version
        nvm install node --reinstall-packages-from="$previous_version"

        # Set the new version as the default
        nvm alias default node

        # Switch to the new default version silently
        nvm use default --silent

        # Update all global npm packages to their latest compatible versions
        echo "🔄 Updating global npm packages..."
        npm update -g

        # Optional: Remove the old Node.js version to save space
        # Uncomment the line below if you want to automatically remove the old version
        # nvm uninstall "$previous_version"

        echo "✅ Node.js updated to $(node -v) and global packages transferred."
    fi

    echo "🔄 Updating Docker components..."
    # Docker update logic (no changes needed, warnings are appropriate)
    if command -v docker &> /dev/null; then
        if [ -d "/Applications/Docker.app" ]; then
            echo "ℹ️ Docker Desktop detected. Please check for updates via the Docker Desktop application."
        fi

        if brew list --formula | grep -q "^docker$"; then
            echo "Updating Docker CLI via Homebrew..."
            brew upgrade docker
        fi

        if brew list --formula | grep -q "^docker-compose$"; then
            echo "Updating Docker Compose via Homebrew..."
            brew upgrade docker-compose
        fi

        if docker info &>/dev/null; then
            echo "Updating Docker images for running containers..."
            for img in $(docker ps --format '{{.Image}}'); do
                echo "Pulling latest version of $img"
                docker pull $img
            done

            echo "Pruning unused Docker images and volumes..."
            docker system prune -af # Added -a flag to prune all unused images, not just dangling ones
            docker volume prune -f
        else
            # This warning is expected and correct if Docker daemon isn't running
            echo "⚠️ Docker daemon is not running. Skipping container updates and cleanup."
            echo "   Start Docker Desktop to perform these operations."
        fi
    else
        echo "⚠️ Docker not found. Skipping Docker updates."
    fi

    # Check uv availability
    if command -v uv &>/dev/null; then
        echo "uv version: $(uv --version 2>&1 | head -n 1)"
    else
        echo "⚠️ uv not found. Install with: brew install uv"
    fi

    echo "✅ All updates completed!"

    # Don't source .zshrc directly to avoid recursion issues
    echo "✅ Run 'source ~/.zshrc' to reload your configuration if needed"
}

